{
  "manifest_version": 2,
  "name": "Okumalık'a Gönder",
  "version": "1.2.0",
  "description": "Açık sayfayı ya da bir bağlantıyı Okumalık'a sonra okunacak veya yer imi olarak, resimleri de Görseller'e gönderir.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "okumalik@okumalik.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["activeTab", "menus", "storage"],
  "background": { "scripts": ["background.js"] },
  "browser_action": {
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" },
    "default_title": "Okumalık'a gönder",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Okumalık penceresini aç"
    }
  }
}
